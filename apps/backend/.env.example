# Database
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Tuya API credentials (get from Tuya IoT Platform)
TUYA_ACCESS_ID=your_access_id_here
TUYA_ACCESS_SECRET=your_access_secret_here
TUYA_REGION=eu

# Polling settings
POLL_INTERVAL_SECONDS=60
DEBOUNCE_POLLS=3
STALE_SENSOR_THRESHOLD_SECONDS=300

# API
API_SECRET_KEY=generate_a_long_random_string_here
FRONTEND_URL=http://localhost:3000
